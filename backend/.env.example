# Copy this file to backend/.env and replace every placeholder before running.
APP_ENV=development
SEED_DEMO_DATA=true
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=accounts-admin
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
COOKIE_SECURE=false
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional automatic payment confirmation SMS via Twilio. Keep live credentials only in backend/.env.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Configure exactly one sender option:
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# Used to normalize 10-digit student mobile numbers (default India).
SMS_DEFAULT_COUNTRY_CODE=+91
# Optional PostgreSQL production URL; install a PostgreSQL driver such as psycopg[binary].
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/college_fees
